{
  "name": "obsidian-web-desk",
  "version": "0.1.0",
  "description": "Obsidian plugin: a free-canvas bookmark desk. Drop URLs, get markdown notes and draggable icons.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bookmark"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.25.11",
    "obsidian": "latest",
    "typescript": "^5.9.3"
  }
}
